[Unit]
Description=Movie Recommender Scraper
After=network.target

[Service]
Type=simple
# Optionally set User to a system user that has permissions to the project directory.
# If left unset the service will run as root. Adjust before enabling on your host.
WorkingDirectory=/opt/filmy-duniya
Environment=PATH=/opt/filmy-duniya/.venv/bin:/usr/bin:/bin
Environment=TMDB_API_KEY=
ExecStart=/opt/filmy-duniya/.venv/bin/python -m src.scraper --n 400 --append --include-tv --interval 86400
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
