  "cards": [
    {
      "dot": "cyan",
      "title": "Two processes, one library",
      "items": [
        "The UI imports src/ directly; nothing in web/ or src/ reads API_URL, so the UI never calls the API",
        "They share state only through files in data/",
        "docker-compose runs backend, frontend and scraper from one image, each mounting ./data"
      ]
    },
    {
      "dot": "amber",
      "title": "Background work",
      "items": [
        "API: scrape + rebuild every REFRESH_INTERVAL_SECONDS (0 disables)",
        "API: retrain every 5 min when ≥5 new events exist",
        "UI: scrape at most once per 24 h, guarded by a stamp and lock file",
        "user_store: retrain on every 3rd feedback event"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and fallbacks",
      "items": [
        "API has no auth; compose binds it to 127.0.0.1",
        "Embedding failure → TF-IDF only; mood-scan failure → mood picker",
        "One shared profile: everyone's likes land in the same files"
      ]
    }
  ]
}