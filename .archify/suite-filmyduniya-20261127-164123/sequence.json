  "cards": [
    {
      "dot": "emerald",
      "title": "All in one process",
      "items": [
        "Every call here is an in-process Python call inside the Streamlit server; no HTTP hop to the FastAPI service",
        "Only the photo crosses the network, from browser to Streamlit"
      ]
    },
    {
      "dot": "amber",
      "title": "Two-stage scoring",
      "items": [
        "mood_picks: rating + taste likeness to liked films (dislikes removed)",
        "user_store: + rule boost from the profile + ranker boost (each clipped)"
      ]
    },
    {
      "dot": "rose",
      "title": "Latency risk",
      "items": [
        "The first similar_space() can embed the whole catalogue (~25 s cold)",
        "Every 3rd like retrains the ranker inside the click handler"
      ]
    }
