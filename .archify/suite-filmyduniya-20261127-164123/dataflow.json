  "cards": [
    {
      "dot": "emerald",
      "title": "Catalogue path",
      "items": [
        "TMDB → scraper → data_loader → movies.csv is the only way titles enter, besides POST /add_movie",
        "Writes are serialized by _CSV_LOCK and published by atomic rename",
        "The UI rereads the CSV every 10 min (st.cache_data ttl)"
      ]
    },
    {
      "dot": "violet",
      "title": "Personal signal",
      "items": [
        "A like/dislike stores the change from the previous verdict, so switching nets out",
        "Training keeps only each title's final verdict as the label",
        "Photos are decoded in memory and never written to disk"
      ]
    },
    {
      "dot": "slate",
      "title": "Not drawn",
      "items": [
        "Posters and trailers: the UI fetches them from TMDB per title (cached 1 h / 24 h)",
        "Watchlist saves go to data/watchlist.json and also record a favorite signal",
        "Index caches in data/cache/ (.npy, .pkl, embeddings .npz)"
      ]
    }
